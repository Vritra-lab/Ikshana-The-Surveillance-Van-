QWidget#wndBody
{
	background-color: #2e3236;
}

QWidget#leftWnd
{
	background-color: #3a3e43;
	border: 1px solid #232629;
}

QPushButton#btnBasicSettings
{
	background-color: #3a3e43;
	border-left:40px solid #3a3e43;
	border-top:none;
	border-bottom:none;
	border-right:none;
	padding-left:50px;
	padding-right:10px;
	background-image: url(./Skin/DustyBlue/SystemConfigUI/Basic-d.png);
	background-repeat:no-repeat;
	background-position: left;
	text-align:left;
	color: #abb2bd;
}
QPushButton#btnBasicSettings:checked
{
	background-image: url(./Skin/DustyBlue/SystemConfigUI/Basic-h.png);
	background-repeat:no-repeat;
	background-position: left;
	border-left:40px solid #2e3236;
	color:#C40123;
	background-color: #2e3236;
}
QPushButton#btnBasicSettings:hover:!checked
{
	background-image: url(./Skin/DustyBlue/SystemConfigUI/Basic-n.png);
	background-repeat:no-repeat;
	background-position: left;
	border-left:40px solid #4A4F56;
	color:#ffffff;
	background-color: #4A4F56;
}
QPushButton#btnBasicSettings:disabled
{
	background-image: url(./Skin/DustyBlue/SystemConfigUI/Basic-d.png);
	background-repeat:no-repeat;
	background-position: left;
	background-color: #3a3e43;
	border-left:40px solid #3a3e43;
}


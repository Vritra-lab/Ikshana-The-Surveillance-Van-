QWidget#wgtContner
{
	background-color: #2e3236;
}

QWidget#rightWnd
{
	background-color: #2e3236;
	border: 1px solid #232629;
}

QWidget#btnContainer
{
	background : #35393e;
	border: 1px solid #232629;
}

QSystemConfigDlg QScrollArea#scrollArea
{
	border: 0px none;
}
QSystemConfigDlg QWidget#QSystemConfigPiece  QFrame#frame
{
	color: #454D55;
}

QSystemConfigDlg QPushButton#btnClose
{
	border-image: url(./Skin/theme1/common/Close.png) 0 60 0 0;
}
QSystemConfigDlg QPushButton#btnClose:hover
{
	border-image: url(./Skin/theme1/common/Close.png) 0 45 0 15;
}
QSystemConfigDlg QPushButton#btnClose:pressed
{
	border-image: url(./Skin/theme1/common/Close.png) 0 30 0 30;
}
QSystemConfigDlg QPushButton#btnClose:disabled
{
	border-image: url(./Skin/theme1/common/Close.png) 0 15 0 45;
}
QSystemConfigDlg QScrollArea#scrollArea
{
	background: #3D4249;
}

QSystemConfigDlg QKeySequenceEditor#label
{
	background: #1e2021;
	color : #ffffff;
	padding: 1px 3px;
}


QWidget#QSystemFileEditorFrame
{
	background: #2e3236;
	border-radius: 3px;
	border: 1px none;
}
QWidget#QSystemFileEditorFrame QLineEdit
{
	background: transparent;
	border: 0px none;
	padding: 4px 8px;
}


QPushButton#btnWav
{
	border-width: 0;
	background: transparent;
	border-image: url(./Skin/DustyBlue/SystemConfigUI/alerton_n.png);
}
QPushButton#btnWav:hover
{
	border-image: url(./Skin/DustyBlue/SystemConfigUI/alerton_h.png);
}
QPushButton#btnWav:pressed
{
	border-image: url(./Skin/DustyBlue/SystemConfigUI/alerton_p.png);
}
QPushButton#btnWav:disabled
{
	border-image: url(./Skin/DustyBlue/SystemConfigUI/alerton_d.png);
}

QSystemConfigDlg QPushButton#btnAdd,
QSystemConfigDlg QPushButton#btnAddTime
{
	border-width: 0;
	border-image: url(./Skin/DustyBlue/SystemConfigUI/Add.png) 0 54 0 0;
}
QSystemConfigDlg QPushButton#btnAdd:hover,
QSystemConfigDlg QPushButton#btnAddTime:hover
{
	border-image: url(./Skin/DustyBlue/SystemConfigUI/Add.png) 0 36 0 18;
}
QSystemConfigDlg QPushButton#btnAdd:pressed,
QSystemConfigDlg QPushButton#btnAddTime:pressed
{
	border-image: url(./Skin/DustyBlue/SystemConfigUI/Add.png) 0 18 0 36;
}
QSystemConfigDlg QPushButton#btnAdd:disabled,
QSystemConfigDlg QPushButton#btnAddTime:disabled
{
	border-image: url(./Skin/DustyBlue/SystemConfigUI/Add.png) 0 0 0 54;
}

QSystemConfigDlg QPushButton[bDelete = true]
{
	border-width: 0;
	border-image: url(./Skin/DustyBlue/SystemConfigUI/Delete.png) 0 54 0 0;
}
QSystemConfigDlg QPushButton[bDelete = true]:hover
{
	border-image: url(./Skin/DustyBlue/SystemConfigUI/Delete.png) 0 36 0 18;
}
QSystemConfigDlg QPushButton[bDelete = true]:pressed
{
	border-image: url(./Skin/DustyBlue/SystemConfigUI/Delete.png) 0 18 0 36;
}
QSystemConfigDlg QPushButton[bDelete = true]:disabled
{
	border-image: url(./Skin/DustyBlue/SystemConfigUI/Delete.png) 0 0 0 54;
}


QSystemConfigDlg QWidget#rightWnd QLabel,
QSystemConfigDlg QWidget#rightWnd QCheckBox,
QSystemConfigDlg QWidget#rightWnd QWidget#wndWavs,
QSystemConfigDlg QWidget#rightWnd QWidget#autoBackupContainer,
QSystemConfigDlg QWidget#rightWnd QWidget#autoBackupContainer QLabel
{
	background: transparent;
}

QPushButton#btnClearExplain,
QPushButton#btnCirculateClearExplain,
QPushButton#btnAutoExPlain,
QPushButton#btnExperiencePlanExplain
{
	border-image:url(./Skin/DustyBlue/SystemConfigUI/Explain-n.png);
}
QPushButton#btnClearExplain,
QPushButton#btnCirculateClearExplain,
QPushButton#btnAutoExPlain,
QPushButton#btnExperiencePlanExplain:hover
{
	border-image:url(./Skin/DustyBlue/SystemConfigUI/Explain-h.png);
}
AlarmCenterUI--QRealPlayEventInfo QWidget#wgtRealPlayWindow
{
	background-color:#35393E;
	border:1px solid #232629;
}

AlarmCenterUI--QRealPlayEventInfo QWidget#wgtTop
{
	background-color:#35393E;
	border-bottom:1px solid #232629;
}

AlarmCenterUI--QRealPlayEventInfo QPushButton#btnSetting
{
	background-color: #35393E;
	border:none;
	padding-left:26px;
	padding-right:6px;
	background-image: url(./Skin/DustyBlue/AlarmCenterUI/setting-n.png);
	background-repeat:no-repeat;
	background-position: left;
	text-align:right;
}
AlarmCenterUI--QRealPlayEventInfo  QPushButton#btnSetting:disabled
{
	background-image: url(./Skin/DustyBlue/AlarmCenterUI/setting-d.png);
} 
AlarmCenterUI--QRealPlayEventInfo  QPushButton#btnSetting:pressed
{
	background-image: url(./Skin/DustyBlue/AlarmCenterUI/setting-p.png);
}
AlarmCenterUI--QRealPlayEventInfo  QPushButton#btnSetting:hover
{
	background-image: url(./Skin/DustyBlue/AlarmCenterUI/setting-h.png);
}
